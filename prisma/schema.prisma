generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum ScriptStatus {
  DRAFT
  CHECKLIST_PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum BatchStatus {
  PENDING
  GENERATING
  COMPLETE
  FAILED
}

enum VariationStatus {
  PENDING
  VOICE_QUEUED
  VOICE_DONE
  RENDER_QUEUED
  RENDER_DONE
  FAILED
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETE
  FAILED
}

enum PostStatus {
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

enum AccountTier {
  SEED
  GROWTH
  SCALE
}

enum AccountHealth {
  HEALTHY
  WARNING
  RESTRICTED
  BANNED
}

enum Platform {
  TIKTOK
  INSTAGRAM_REELS
  YOUTUBE_SHORTS
  FACEBOOK_REELS
}

enum HookType {
  QUESTION
  BOLD_CLAIM
  STORY
  STATISTIC
  CONTROVERSY
}

enum AvatarType {
  MALE_YOUNG
  MALE_MIDDLE
  FEMALE_YOUNG
  FEMALE_MIDDLE
  AI_GENERATED
}

enum LengthType {
  SHORT_15
  MEDIUM_30
  LONG_60
}

enum DeliveryRegister {
  CASUAL
  AUTHORITATIVE
  EMOTIONAL
  HUMOROUS
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum IntegrationProvider {
  OPENAI
  ANTHROPIC
  ELEVENLABS
  HEYGEN
  SYNTHESIA
  SUPABASE
  AWS_S3
  TIKTOK
  INSTAGRAM
  YOUTUBE
  FACEBOOK
}

enum PromptCategory {
  HOOK_GENERATION
  SCRIPT_WRITING
  PERSONA_RESEARCH
  CHECKLIST_SCORING
  WEEKLY_REVIEW
  OPTIMIZATION
}

enum WeeklyTargetStatus {
  PLANNED
  IN_PROGRESS
  COMPLETE
  MISSED
}

enum WorkflowStatus {
  PLANNED
  RUNNING
  PAUSED
  COMPLETE
  FAILED
}

enum JobLogType {
  SCRIPT_GENERATION
  VOICE_SYNTHESIS
  VIDEO_RENDER
  SOCIAL_PUBLISH
  CHECKLIST_SCORE
  WEEKLY_ANALYSIS
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  RETRY
  CONFIG_CHANGE
}

enum CreativeType {
  HOOK
  CTA
  AVATAR_REF
  VOICE_SAMPLE
  CONCEPT
  SCRIPT_TEMPLATE
}

enum OutputFormat {
  VIDEO
  IMAGE
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  clerkId   String?  @unique @map("clerk_id")
  name      String
  email     String   @unique
  role      UserRole @default(OPERATOR)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Offer {
  id                  String   @id @default(cuid())
  name                String
  aov                 Decimal  @db.Decimal(10, 2)
  ltv                 Decimal  @db.Decimal(10, 2)
  targetCac           Decimal  @map("target_cac") @db.Decimal(10, 2)
  conversionRate      Decimal  @map("conversion_rate") @db.Decimal(5, 4)
  contentToClickRatio Decimal  @map("content_to_click_ratio") @db.Decimal(5, 4)
  revenueTarget       Decimal  @map("revenue_target") @db.Decimal(12, 2)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  personas Persona[]
  scripts  Script[]

  @@map("offers")
}

model Persona {
  id                     String   @id @default(cuid())
  offerId                String   @map("offer_id")
  name                   String
  demographicJson        Json     @map("demographic_json")
  psychographicJson      Json     @map("psychographic_json")
  painJson               Json     @map("pain_json")
  failedAlternativesJson Json     @map("failed_alternatives_json")
  transformationJson     Json     @map("transformation_json")
  version                Int      @default(1)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  offer   Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  scripts Script[]

  @@map("personas")
}

model Script {
  id                 String       @id @default(cuid())
  offerId            String       @map("offer_id")
  personaId          String       @map("persona_id")
  conceptName        String       @map("concept_name")
  hookText           String       @map("hook_text") @db.Text
  painText           String       @map("pain_text") @db.Text
  mechanismText      String       @map("mechanism_text") @db.Text
  solutionText       String       @map("solution_text") @db.Text
  transformationText String       @map("transformation_text") @db.Text
  ctaText            String       @map("cta_text") @db.Text
  fullScript         String       @map("full_script") @db.Text
  durationSeconds    Int          @map("duration_seconds")
  status             ScriptStatus @default(DRAFT)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  offer            Offer             @relation(fields: [offerId], references: [id], onDelete: Cascade)
  persona          Persona           @relation(fields: [personaId], references: [id], onDelete: Cascade)
  checklists       ScriptChecklist[]
  variationBatches VariationBatch[]

  @@index([offerId])
  @@index([personaId])
  @@index([status])
  @@map("scripts")
}

model ScriptChecklist {
  id        String   @id @default(cuid())
  scriptId  String   @map("script_id")
  score     Int
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  script Script @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@map("script_checklists")
}

model VariationBatch {
  id        String      @id @default(cuid())
  scriptId  String      @map("script_id")
  name      String
  status    BatchStatus @default(PENDING)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  script     Script      @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  variations Variation[]

  @@index([scriptId])
  @@map("variation_batches")
}

model Variation {
  id               String           @id @default(cuid())
  batchId          String           @map("batch_id")
  hookType         HookType         @map("hook_type")
  avatarType       AvatarType       @map("avatar_type")
  lengthType       LengthType       @map("length_type")
  deliveryRegister DeliveryRegister @map("delivery_register")
  platform         Platform
  outputFormat     OutputFormat     @default(VIDEO) @map("output_format")
  width            Int              @default(1080)
  height           Int              @default(1920)
  status           VariationStatus  @default(PENDING)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  batch                VariationBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  voiceJobs            VoiceJob[]
  videoJobs            VideoJob[]
  creativeLibraryItems CreativeLibrary[]

  @@index([batchId])
  @@index([status])
  @@map("variations")
}

model VoiceJob {
  id             String    @id @default(cuid())
  variationId    String    @map("variation_id")
  sourceAudioUrl String?   @map("source_audio_url")
  finalAudioUrl  String?   @map("final_audio_url")
  status         JobStatus @default(QUEUED)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  variation Variation  @relation(fields: [variationId], references: [id], onDelete: Cascade)
  videoJobs VideoJob[]

  @@index([variationId])
  @@map("voice_jobs")
}

model VideoJob {
  id          String    @id @default(cuid())
  variationId String    @map("variation_id")
  voiceJobId  String    @map("voice_job_id")
  videoUrl    String?   @map("video_url")
  status      JobStatus @default(QUEUED)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  variation      Variation       @relation(fields: [variationId], references: [id], onDelete: Cascade)
  voiceJob       VoiceJob        @relation(fields: [voiceJobId], references: [id], onDelete: Cascade)
  scheduledPosts ScheduledPost[]

  @@index([variationId])
  @@index([voiceJobId])
  @@map("video_jobs")
}

model Account {
  id              String        @id @default(cuid())
  platform        Platform
  handle          String
  tier            AccountTier   @default(SEED)
  warmthDay       Int           @default(0) @map("warmth_day")
  dailyPostTarget Int           @default(1) @map("daily_post_target")
  healthStatus    AccountHealth @default(HEALTHY) @map("health_status")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  scheduledPosts ScheduledPost[]

  @@unique([platform, handle])
  @@map("accounts")
}

model ScheduledPost {
  id            String     @id @default(cuid())
  videoJobId    String     @map("video_job_id")
  accountId     String     @map("account_id")
  scheduledTime DateTime   @map("scheduled_time")
  status        PostStatus @default(SCHEDULED)
  publishedUrl  String?    @map("published_url")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  videoJob          VideoJob           @relation(fields: [videoJobId], references: [id], onDelete: Cascade)
  account           Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  performanceMetric PerformanceMetric?

  @@index([accountId])
  @@index([scheduledTime])
  @@index([status])
  @@map("scheduled_posts")
}

model PerformanceMetric {
  id              String   @id @default(cuid())
  scheduledPostId String   @unique @map("scheduled_post_id")
  views48h        Int      @default(0) @map("views_48h")
  views7d         Int      @default(0) @map("views_7d")
  watchThrough7d  Decimal  @default(0) @map("watch_through_7d") @db.Decimal(5, 4)
  saveRate7d      Decimal  @default(0) @map("save_rate_7d") @db.Decimal(5, 4)
  ctr7d           Decimal  @default(0) @map("ctr_7d") @db.Decimal(5, 4)
  clicks          Int      @default(0)
  purchases       Int      @default(0)
  revenue         Decimal  @default(0) @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  scheduledPost ScheduledPost @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)

  @@map("performance_metrics")
}

model WeeklyReview {
  id               String   @id @default(cuid())
  weekStart        DateTime @unique @map("week_start")
  summary          String   @db.Text
  topPatternsJson  Json     @map("top_patterns_json")
  weakPatternsJson Json     @map("weak_patterns_json")
  nextActionsJson  Json     @map("next_actions_json")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("weekly_reviews")
}

model Integration {
  id              String              @id @default(cuid())
  name            String
  provider        IntegrationProvider @unique
  apiKeyEncrypted String              @map("api_key_encrypted") @db.Text
  baseUrl         String?             @map("base_url")
  isEnabled       Boolean             @default(true) @map("is_enabled")
  status          IntegrationStatus   @default(DISCONNECTED)
  lastTestedAt    DateTime?           @map("last_tested_at")
  lastError       String?             @map("last_error") @db.Text
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@map("integrations")
}

model PromptTemplate {
  id        String         @id @default(cuid())
  name      String
  category  PromptCategory
  content   String         @db.Text
  version   Int            @default(1)
  isDefault Boolean        @default(false) @map("is_default")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@unique([category, version])
  @@map("prompt_templates")
}

model ProductionRule {
  id                    String   @id @default(cuid())
  workspaceId           String   @unique @default("default") @map("workspace_id")
  videosPerWeek         Int      @default(30) @map("videos_per_week")
  hookVariantsPerScript Int      @default(3) @map("hook_variants_per_script")
  avatarVariantsPerHook Int      @default(2) @map("avatar_variants_per_hook")
  lengthVariants        Int      @default(2) @map("length_variants")
  deliveryVariants      Int      @default(2) @map("delivery_variants")
  accountsActive        Int      @default(3) @map("accounts_active")
  postsPerAccount       Int      @default(3) @map("posts_per_account")
  approvalRequired      Boolean  @default(true) @map("approval_required")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("production_rules")
}

model JobLog {
  id           String     @id @default(cuid())
  jobType      JobLogType @map("job_type")
  provider     String
  status       JobStatus  @default(QUEUED)
  errorMessage String?    @map("error_message") @db.Text
  startedAt    DateTime   @default(now()) @map("started_at")
  endedAt      DateTime?  @map("ended_at")
  costEstimate Decimal?   @map("cost_estimate") @db.Decimal(8, 4)

  @@index([jobType])
  @@index([status])
  @@map("job_logs")
}

model CampaignPreset {
  id           String   @id @default(cuid())
  name         String
  category     String
  settingsJson Json     @map("settings_json")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("campaign_presets")
}

model WeeklyTarget {
  id         String             @id @default(cuid())
  weekStart  DateTime           @unique @map("week_start")
  videoGoal  Int                @map("video_goal")
  postGoal   Int                @map("post_goal")
  scriptGoal Int                @map("script_goal")
  renderGoal Int                @map("render_goal")
  status     WeeklyTargetStatus @default(PLANNED)
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  @@map("weekly_targets")
}

model WorkflowRun {
  id              String         @id @default(cuid())
  name            String
  weekStart       DateTime       @map("week_start")
  status          WorkflowStatus @default(PLANNED)
  videosTarget    Int            @map("videos_target")
  videosCompleted Int            @default(0) @map("videos_completed")
  notes           String?        @db.Text
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([weekStart])
  @@map("workflow_runs")
}

model GlobalSettings {
  id                          String   @id @default(cuid())
  workspaceId                 String   @unique @default("default") @map("workspace_id")
  workspaceName               String   @default("My Workspace") @map("workspace_name")
  brandName                   String   @default("") @map("brand_name")
  timezone                    String   @default("UTC")
  currency                    String   @default("USD")
  defaultVideoGoalPerWeek     Int      @default(30) @map("default_video_goal_per_week")
  defaultPostGoalPerAccount   Int      @default(3) @map("default_post_goal_per_account")
  defaultTargetCtr            Decimal  @default(0.02) @map("default_target_ctr") @db.Decimal(5, 4)
  defaultTargetConversionRate Decimal  @default(0.03) @map("default_target_conversion_rate") @db.Decimal(5, 4)
  defaultTargetCac            Decimal  @default(25.00) @map("default_target_cac") @db.Decimal(10, 2)
  defaultAov                  Decimal  @default(50.00) @map("default_aov") @db.Decimal(10, 2)
  defaultLtv                  Decimal  @default(150.00) @map("default_ltv") @db.Decimal(10, 2)
  beginnerMode                Boolean  @default(true) @map("beginner_mode")
  advancedMode                Boolean  @default(false) @map("advanced_mode")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  @@map("global_settings")
}

model ApprovalSettings {
  id                  String   @id @default(cuid())
  workspaceId         String   @unique @default("default") @map("workspace_id")
  personaApproval     Boolean  @default(false) @map("persona_approval")
  scriptApproval      Boolean  @default(true) @map("script_approval")
  hookApproval        Boolean  @default(false) @map("hook_approval")
  voiceApproval       Boolean  @default(false) @map("voice_approval")
  videoApproval       Boolean  @default(true) @map("video_approval")
  scheduleApproval    Boolean  @default(false) @map("schedule_approval")
  weeklyBriefApproval Boolean  @default(false) @map("weekly_brief_approval")
  autoApproveLowRisk  Boolean  @default(true) @map("auto_approve_low_risk")
  confidenceThreshold Float    @default(0.8) @map("confidence_threshold")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("approval_settings")
}

model PlatformRule {
  id                 String   @id @default(cuid())
  platform           Platform @unique
  defaultAspectRatio String   @default("9:16") @map("default_aspect_ratio")
  captionStyle       String   @default("default") @map("caption_style")
  maxDailyPosts      Int      @default(3) @map("max_daily_posts")
  warmUpRules        Json     @map("warm_up_rules")
  namingConvention   String?  @map("naming_convention")
  isEnabled          Boolean  @default(true) @map("is_enabled")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("platform_rules")
}

model CostControl {
  id               String   @id @default(cuid())
  workspaceId      String   @unique @default("default") @map("workspace_id")
  dailySpendCap    Decimal? @map("daily_spend_cap") @db.Decimal(10, 2)
  weeklySpendCap   Decimal? @map("weekly_spend_cap") @db.Decimal(10, 2)
  pauseOnThreshold Boolean  @default(false) @map("pause_on_threshold")
  warnOnCacBreak   Boolean  @default(true) @map("warn_on_cac_break")
  costPerScript    Decimal? @map("cost_per_script") @db.Decimal(8, 4)
  costPerVoice     Decimal? @map("cost_per_voice") @db.Decimal(8, 4)
  costPerVideo     Decimal? @map("cost_per_video") @db.Decimal(8, 4)
  costPerPost      Decimal? @map("cost_per_post") @db.Decimal(8, 4)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("cost_controls")
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?     @map("user_id")
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  changes    Json
  ipAddress  String?     @map("ip_address")
  timestamp  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

model CreativeLibrary {
  id                String       @id @default(cuid())
  name              String
  type              CreativeType
  content           String       @db.Text
  tags              Json         @default("[]")
  isWinner          Boolean      @default(false) @map("is_winner")
  sourceVariationId String?      @map("source_variation_id")
  performanceScore  Float?       @map("performance_score")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  sourceVariation Variation? @relation(fields: [sourceVariationId], references: [id], onDelete: SetNull)

  @@index([type, isWinner])
  @@map("creative_library")
}

model AdapterConfig {
  id                      String               @id @default(cuid())
  workspaceId             String               @unique @default("default") @map("workspace_id")
  aiProvider              IntegrationProvider? @map("ai_provider")
  voiceProvider           IntegrationProvider? @map("voice_provider")
  videoProvider           IntegrationProvider? @map("video_provider")
  storageProvider         IntegrationProvider? @map("storage_provider")
  socialTiktokProvider    IntegrationProvider? @map("social_tiktok_provider")
  socialInstagramProvider IntegrationProvider? @map("social_instagram_provider")
  socialYoutubeProvider   IntegrationProvider? @map("social_youtube_provider")
  socialFacebookProvider  IntegrationProvider? @map("social_facebook_provider")
  fallbackToMock          Boolean              @default(true) @map("fallback_to_mock")
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")

  @@map("adapter_configs")
}
